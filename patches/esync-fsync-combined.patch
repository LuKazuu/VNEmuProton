# esync-fsync-combined.patch
#
# eventfd-based esync + fsync/inproc-sync integration for VNEmuProton (Android/Termux).
# Combined from the following patches, in this order (each touches a different file):
#   dlls_ntdll_makefile_in.patch
#   dlls_ntdll_unix_esync_c.patch
#   dlls_ntdll_unix_esync_h.patch
#   dlls_ntdll_unix_fsync_c.patch
#   dlls_ntdll_unix_server_c.patch
#   dlls_ntdll_unix_sync_c.patch
#   server_esync_c.patch
#   server_esync_h.patch
#   server_fsync_c.patch
#   server_inproc_sync_c.patch
#   server_main_c.patch
#   server_makefile_in.patch
#   server_protocol_def.patch
#   server_thread_c.patch
#
# Needs android/shm_utils/ (copied into the source tree by build.sh).

