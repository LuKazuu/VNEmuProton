+/***********************************************************************
+ *           remap_section_anonymous_exec
+ *
+ * Fallback for noexec filesystems and strict-W^X kernels: replace a
+ * file-backed mapping that could not be given PROT_EXEC with a fresh
+ * anonymous mapping that can.
+ *
+ * The kernel's MS_NOEXEC restriction only applies to file-backed
+ * mappings whose backing file lives on a noexec mount (e.g. Android's
+ * /sdcard via sdcardfs/FUSE). Anonymous mappings are never subject to
+ * MS_NOEXEC, so a MAP_PRIVATE|MAP_ANONYMOUS mapping can always be
+ * created with PROT_EXEC, even on a noexec filesystem.
+ *
+ * On strict-W^X kernels (e.g. Android arm64), mprotect() that flips a
+ * page from RW to RX is rejected. By munmap'ing the page and
+ * re-mmap'ing it as PROT_READ|PROT_WRITE|PROT_EXEC anonymous, we get a
+ * fresh page that the kernel will let us have executable.
+ *
+ * virtual_mutex must be held by caller. The caller's vprot table is
+ * assumed to already reflect the desired final protection (set_vprot
+ * updates it before calling mprotect_range, so by the time we get
+ * here the page table is correct -- only the kernel mapping is
+ * wrong). On success this function re-applies that protection so the
+ * anonymous mapping does not stay RWX.
+ *
+ * The original file-backed section is only dropped after we have both
+ * (a) verified that anonymous executable mappings are permitted at all
+ * and (b) saved the section contents, and it is restored on failure so
+ * the image is never left with an unmapped hole.
+ */
+static NTSTATUS remap_section_anonymous_exec( struct file_view *view, void *base, size_t size,
+                                              int fd, off_t file_start, size_t file_size, BOOL removable )
+{
+    void *addr, *probe;
+    void *tmp;
+    off_t view_offset = (char *)base - (char *)view->base;
+
+    probe = mmap( NULL, host_page_size, PROT_READ | PROT_WRITE | PROT_EXEC,
+                  MAP_PRIVATE | MAP_ANONYMOUS, -1, 0 );
+    if (probe == MAP_FAILED) return STATUS_NO_MEMORY;
+    munmap( probe, host_page_size );
+
+    if (!(tmp = malloc( size ))) return STATUS_NO_MEMORY;
+    memcpy( tmp, base, size );
+
+    if (munmap( base, size ))
+    {
+        free( tmp );
+        return STATUS_NO_MEMORY;
+    }
+
+    addr = mmap( base, size, PROT_READ | PROT_WRITE | PROT_EXEC,
+                 MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0 );
+    if (addr != base)
+    {
+        if (file_size &&
+            map_file_into_view( view, fd, view_offset, file_size, file_start,
+                                VPROT_COMMITTED | VPROT_READ | VPROT_WRITECOPY, removable ) == STATUS_SUCCESS &&
+            (file_size == size ||
+             mmap( (char *)base + file_size, size - file_size, PROT_READ | PROT_WRITE,
+                   MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0 ) == (char *)base + file_size))
+        {
+            memcpy( base, tmp, size );
+            free( tmp );
+            return STATUS_ACCESS_DENIED;
+        }
+
+        if (mmap( base, size, PROT_READ | PROT_WRITE,
+                  MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0 ) == base)
+        {
+            memcpy( base, tmp, size );
+            free( tmp );
+            return STATUS_ACCESS_DENIED;
+        }
+        free( tmp );
+        return STATUS_NO_MEMORY;
+    }
+
+    memcpy( base, tmp, size );
+    free( tmp );
+
+    if (mprotect_range( base, size, 0, 0 ))
+    {
+        ERR( "failed to re-apply protection on remapped section %p-%p\n",
+             base, (char *)base + size - 1 );
+        return STATUS_ACCESS_DENIED;
+    }
+    return STATUS_SUCCESS;
+}
